{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs these files directly by stripping types, so only erasable syntax is
    // allowed and every relative import names its .ts file.
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
