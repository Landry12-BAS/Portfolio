# Settings for running the Node systems locally (`just node-api`, `just node-worker`,
# `just node-migrate`, `just node-seed`). Copy this file to .env in this folder. Never
# commit .env: deployed settings live in SOPS-encrypted secrets. A variable left empty
# counts as not set.

LB_NODE_HOST=127.0.0.1
LB_NODE_PORT=8002
LB_NODE_LOG_LEVEL=info

# One Postgres 17 with pgvector; each system works in a schema of its own (lb08 for LB-08).
# For a local one: docker run -d --name lb-postgres -e POSTGRES_USER=lb -e POSTGRES_PASSWORD=lb
#   -p 127.0.0.1:5432:5432 pgvector/pgvector:pg17
LB_DATABASE_URL=postgres://lb:lb@127.0.0.1:5432/lb
# In production LB-08 logs in as a role that owns only its schema; set its URL here, and
# the shared URL above is not used for it.
LB08_DATABASE_URL=

# Redis holds the BullMQ queues and the run spans. Every key starts with this prefix.
LB_REDIS_URL=redis://127.0.0.1:6379/0
LB_REDIS_PREFIX=lb:

# The site's Ed25519 public key (base64url, a JWK's `x`), which visitor tokens must be
# signed with. Without it, the API refuses every visitor.
LB_WEB_TOKEN_KEY=

# The AI gateway (`just gateway`), which the API needs to describe workflows. Make the key
# file with `just gateway-token keygen node-systems ~/.lb/node-systems.jwk.json` and paste
# the public key it prints into the gateway's LB_SERVICE_KEYS. The worker needs none of this.
LB_GATEWAY_URL=http://127.0.0.1:8080
LB_SERVICE_NAME=node-systems
LB_SERVICE_KEY_FILE=

# Where the synthetic seed data lives; empty means the repository's data/seed.
LB_SEED_DIR=
