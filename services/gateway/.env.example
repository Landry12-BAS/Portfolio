# Settings for running the gateway locally with `just gateway`. Copy this file to
# .env in this folder. Never commit .env: deployed keys live in SOPS-encrypted secrets.

# `dev` lets synthetic calls reach dev-only providers such as NVIDIA; `production`
# (the default) keeps them off every chain.
LB_GATEWAY_PROFILE=dev
LB_GATEWAY_HOST=127.0.0.1
LB_GATEWAY_PORT=8080
LB_GATEWAY_LOG_LEVEL=info
LB_REDIS_URL=redis://127.0.0.1:6379

# JSON map of calling service to its Ed25519 public key. `just gateway-token keygen
# django-systems ~/.lb/django-systems.jwk.json` prints the entry to paste here.
LB_SERVICE_KEYS=

# Provider keys. A provider without its key is left off every chain.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
