{
  "components": {
    "schemas": {
      "AnswerOut": {
        "description": "What a question came to: how it ended, every query tried, and the table, chart and explanation when it ran.",
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttemptOut"
            },
            "title": "Attempts",
            "type": "array"
          },
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChartOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "explanation_source": {
            "anyOf": [
              {
                "enum": [
                  "model",
                  "fallback"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Source"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "model_calls": {
            "title": "Model Calls",
            "type": "integer"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "remaining_questions": {
            "title": "Remaining Questions",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "outcome",
          "as_of",
          "model_calls",
          "elapsed_ms",
          "attempts",
          "message",
          "result",
          "chart",
          "explanation",
          "explanation_source",
          "remaining_questions"
        ],
        "title": "AnswerOut",
        "type": "object"
      },
      "AskIn": {
        "additionalProperties": false,
        "description": "A visitor's question, in their own words. Nothing else is accepted next to it.",
        "properties": {
          "question": {
            "$ref": "#/components/schemas/Question"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskIn",
        "type": "object"
      },
      "AttemptOut": {
        "description": "One query the model wrote, and the layer and rule that stopped it, or none when it ran.\n\n`sql` is the model's own text: untrusted, to be shown as text and never run or rendered as markup.",
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "rule": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rule"
              },
              {
                "type": "null"
              }
            ]
          },
          "sql": {
            "title": "Sql",
            "type": "string"
          },
          "stopped_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Layer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sql",
          "stopped_by",
          "rule",
          "message"
        ],
        "title": "AttemptOut",
        "type": "object"
      },
      "CellValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "ChartKind": {
        "enum": [
          "bar",
          "line",
          "point"
        ],
        "type": "string"
      },
      "ChartOut": {
        "description": "A chart, as a Vega-Lite 5 spec built by this service from the result (never by the model).",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChartKind"
          },
          "omitted_rows": {
            "title": "Omitted Rows",
            "type": "integer"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "spec",
          "omitted_rows"
        ],
        "title": "ChartOut",
        "type": "object"
      },
      "ColumnDescriptionOut": {
        "description": "A column of the semantic layer, as the model is told of it.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nullable": {
            "title": "Nullable",
            "type": "boolean"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "name",
          "type",
          "description",
          "values",
          "nullable"
        ],
        "title": "ColumnDescriptionOut",
        "type": "object"
      },
      "ColumnKind": {
        "enum": [
          "text",
          "integer",
          "number",
          "date",
          "boolean",
          "other"
        ],
        "type": "string"
      },
      "ColumnOut": {
        "description": "One column of a result: its name and the kind of value it holds.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ColumnKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "title": "ColumnOut",
        "type": "object"
      },
      "DimensionOut": {
        "description": "A way to slice a metric, with its exact definition.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "expression": {
            "title": "Expression",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs": {
            "items": {
              "type": "string"
            },
            "title": "Needs",
            "type": "array"
          },
          "synonyms": {
            "items": {
              "type": "string"
            },
            "title": "Synonyms",
            "type": "array"
          }
        },
        "required": [
          "name",
          "description",
          "expression",
          "needs",
          "synonyms"
        ],
        "title": "DimensionOut",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "What went wrong, as a stable code and a sentence for people.\n\n`fields` names the fields a 422 faults, and `resets_at` says when a daily limit starts again.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "resets_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Resets At"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorOut": {
        "description": "The error shape the whole platform answers with, as the OpenAPI document describes it.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "HealthOut": {
        "description": "The liveness answer.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "JoinOut": {
        "description": "An allowed join: two columns that may be set equal.",
        "properties": {
          "left": {
            "title": "Left",
            "type": "string"
          },
          "right": {
            "title": "Right",
            "type": "string"
          }
        },
        "required": [
          "left",
          "right"
        ],
        "title": "JoinOut",
        "type": "object"
      },
      "Layer": {
        "description": "The defences a query passes through, in order. Each can stop it.",
        "enum": [
          "parse",
          "allowlist",
          "explain",
          "connection",
          "row_limit",
          "timeout"
        ],
        "title": "Layer",
        "type": "string"
      },
      "LimitsOut": {
        "description": "The limits LB-05 enforces, which are the ones its datasheet promises.",
        "properties": {
          "max_model_calls_per_question": {
            "title": "Max Model Calls Per Question",
            "type": "integer"
          },
          "query_timeout_seconds": {
            "title": "Query Timeout Seconds",
            "type": "number"
          },
          "question_deadline_seconds": {
            "title": "Question Deadline Seconds",
            "type": "number"
          },
          "questions_per_day": {
            "title": "Questions Per Day",
            "type": "integer"
          },
          "row_cap": {
            "title": "Row Cap",
            "type": "integer"
          }
        },
        "required": [
          "questions_per_day",
          "query_timeout_seconds",
          "row_cap",
          "max_model_calls_per_question",
          "question_deadline_seconds"
        ],
        "title": "LimitsOut",
        "type": "object"
      },
      "MetricOut": {
        "description": "A metric: what it means, and the exact definition a question that names it is given.",
        "properties": {
          "definition": {
            "title": "Definition",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "enum": [
              "expression",
              "worked_example"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs": {
            "items": {
              "type": "string"
            },
            "title": "Needs",
            "type": "array"
          },
          "synonyms": {
            "items": {
              "type": "string"
            },
            "title": "Synonyms",
            "type": "array"
          }
        },
        "required": [
          "name",
          "label",
          "description",
          "kind",
          "definition",
          "needs",
          "synonyms"
        ],
        "title": "MetricOut",
        "type": "object"
      },
      "Outcome": {
        "description": "How a question ended.",
        "enum": [
          "answered",
          "declined",
          "refused",
          "unavailable"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "Question": {
        "maxLength": 300,
        "minLength": 5,
        "type": "string"
      },
      "QuotaOut": {
        "description": "A visitor's questions today, and the limits.",
        "properties": {
          "limits": {
            "$ref": "#/components/schemas/LimitsOut"
          },
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          },
          "resets_at": {
            "format": "date-time",
            "title": "Resets At",
            "type": "string"
          },
          "used": {
            "title": "Used",
            "type": "integer"
          }
        },
        "required": [
          "used",
          "remaining",
          "resets_at",
          "limits"
        ],
        "title": "QuotaOut",
        "type": "object"
      },
      "RangeOut": {
        "description": "A date phrase the resolver understands, and the dates it means counted from the data's last day.",
        "properties": {
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "start",
          "end"
        ],
        "title": "RangeOut",
        "type": "object"
      },
      "ReadinessOut": {
        "additionalProperties": {
          "type": "boolean"
        },
        "description": "The readiness answer: for each system, whether it can serve right now.",
        "title": "ReadinessOut",
        "type": "object"
      },
      "ResultOut": {
        "description": "The table a query returned, and the checked SQL that produced it.",
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnOut"
            },
            "title": "Columns",
            "type": "array"
          },
          "elapsed_ms": {
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "joins": {
            "title": "Joins",
            "type": "integer"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/CellValue"
              },
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          },
          "sql": {
            "title": "Sql",
            "type": "string"
          },
          "tables": {
            "items": {
              "type": "string"
            },
            "title": "Tables",
            "type": "array"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "sql",
          "columns",
          "rows",
          "row_count",
          "truncated",
          "elapsed_ms",
          "tables",
          "joins"
        ],
        "title": "ResultOut",
        "type": "object"
      },
      "Rule": {
        "description": "What a layer found wrong. Each rule belongs to one layer and is either worth a second try or not.",
        "enum": [
          "empty",
          "too_long",
          "invalid_characters",
          "syntax_error",
          "too_complex",
          "multiple_statements",
          "not_select",
          "catalog_access",
          "file_access",
          "table_function",
          "unknown_table",
          "unknown_column",
          "function_not_allowed",
          "construct_not_allowed",
          "join_not_allowed",
          "limit_not_allowed",
          "too_many_columns",
          "unstable_rendering",
          "check_failed",
          "binder_error",
          "plan_too_large",
          "cross_product",
          "connection_refused",
          "runtime_error",
          "out_of_memory",
          "timeout",
          "row_cap"
        ],
        "title": "Rule",
        "type": "string"
      },
      "SemanticLayerOut": {
        "description": "The semantic layer: everything the model is told about the data, and so everything a query may use.",
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/DimensionOut"
            },
            "title": "Dimensions",
            "type": "array"
          },
          "joins": {
            "items": {
              "$ref": "#/components/schemas/JoinOut"
            },
            "title": "Joins",
            "type": "array"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricOut"
            },
            "title": "Metrics",
            "type": "array"
          },
          "ranges": {
            "items": {
              "$ref": "#/components/schemas/RangeOut"
            },
            "title": "Ranges",
            "type": "array"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableOut"
            },
            "title": "Tables",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "as_of",
          "tables",
          "joins",
          "metrics",
          "dimensions",
          "ranges"
        ],
        "title": "SemanticLayerOut",
        "type": "object"
      },
      "TableOut": {
        "description": "A table of the semantic layer.",
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnDescriptionOut"
            },
            "title": "Columns",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "columns"
        ],
        "title": "TableOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "visitor": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The API behind the LB systems built on Flask.",
    "title": "LB Flask systems",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "operationId": "platform_health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Report that the process is up. It checks nothing else, so a database blip never restarts it.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/lb05/ask": {
      "post": {
        "description": "<br/>Counts against the visitor's 25 questions a day, which the service enforces itself, and a<br/>visitor has one question running at a time. A question the service itself fails to answer is not<br/>counted, for up to five such questions a day: after that a failed question counts too.",
        "operationId": "lb05_ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "visitor": []
          }
        ],
        "summary": "Answer a question about the sales data, synchronously: the SQL, the table, a chart and an explanation.",
        "tags": [
          "lb-05"
        ]
      }
    },
    "/api/lb05/quota": {
      "get": {
        "operationId": "lb05_quota_quota_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "visitor": []
          }
        ],
        "summary": "Read how many questions the visitor has left today, and the limits LB-05 enforces.",
        "tags": [
          "lb-05"
        ]
      }
    },
    "/api/lb05/semantic-layer": {
      "get": {
        "operationId": "lb05_semantic_layer_semantic_layer_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticLayerOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "visitor": []
          }
        ],
        "summary": "Read the semantic layer: the tables, joins, metrics and slices a question may use, and what each means.",
        "tags": [
          "lb-05"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "operationId": "platform_ready_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
