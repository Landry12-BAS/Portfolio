# Settings for `just flask`, `just seed-lb05`, `just eval-lb05`, `just eval-lb03` and
# `just sweep-lb03`. Copy this file to .env (git ignores it) and fill it in.
# config/environment.py checks every variable when the app starts and names each
# problem it finds, never a value.

# Hosts the service answers to, comma separated. Any other Host header gets a 400.
FLASK_ALLOWED_HOSTS=127.0.0.1,localhost

# One Postgres database, one schema per system. In production LB-05 and LB-03 log in as
# roles granted only their own schema: set LB05_DATABASE_URL and LB03_DATABASE_URL for
# them, and leave the shared URL to the other systems.
LB_DATABASE_URL=postgres://lb:lb@127.0.0.1:5432/lb
# LB05_DATABASE_URL=postgres://lb05:change-me@127.0.0.1:5432/lb
# LB03_DATABASE_URL=postgres://lb03:change-me@127.0.0.1:5432/lb

# Redis carries the run spans the Scope reads, under the gateway's key prefix.
LB_REDIS_URL=redis://127.0.0.1:6379/0
LB_REDIS_PREFIX=lb:

# The site's Ed25519 public key (base64url), which visitor tokens must be signed with.
# Without it every visitor call is refused.
# LB_WEB_TOKEN_KEY=

# The AI gateway (`just gateway`), and this service's own key pair from
# `just gateway-token keygen flask-systems <key-file>`. All three or none: without them
# the service runs, but cannot answer a question.
# LB_GATEWAY_URL=http://127.0.0.1:8080
# LB_SERVICE_NAME=flask-systems
# LB_SERVICE_KEY_FILE=/home/you/.lb/flask-systems.jwk.json

# Where LB-05's generated sales data lives (`just seed-lb05` writes it). Defaults to
# data/generated/lb05 in the repository.
# LB05_WAREHOUSE_DIR=

# What one DuckDB query may use on this machine. The defaults suit the 2-core box.
# LB05_DUCKDB_MEMORY_LIMIT=1GB
# LB05_DUCKDB_THREADS=2

# Where LB-03 keeps an uploaded file and the picture of each of its pages, for an hour:
# `local` (a folder; the default is data/generated/lb03/files in the repository) or `s3`
# (a private bucket on an S3-compatible service such as Cloudflare R2; the four settings
# below are then all required). The service deletes files at their hour itself, every
# minute; a bucket's lifecycle rule works in whole days and is only a backstop.
# LB03_STORAGE=local
# LB03_FILES_DIR=
# LB03_S3_BUCKET=
# LB03_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LB03_S3_REGION=auto
# LB03_S3_ACCESS_KEY_ID=
# LB03_S3_SECRET_ACCESS_KEY=

# LB-03's OCR runs in a caged child process. How many may run at once (1 to 4; the
# 2-core box reads one document at a time), and where each gets a folder of its own to
# work in (the system's temporary folder by default; the stack gives it a small
# memory-backed one).
# LB03_OCR_WORKERS=1
# LB03_SCRATCH_DIR=

# Gunicorn, read by gunicorn.conf.py.
# GUNICORN_BIND=127.0.0.1:8102
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
