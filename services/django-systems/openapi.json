  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "description": "Report that the process is up. It checks nothing else, so a database blip never restarts it.",
        "operationId": "config_api_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
