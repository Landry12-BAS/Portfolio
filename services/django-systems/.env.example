# Settings for running the Django systems locally (`just migrate`, `just seed`). Copy
# this file to .env in this folder. Never commit .env: deployed settings live in
# SOPS-encrypted secrets.

# Make your own: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# One Postgres 17 with pgvector; each system works in a schema of its own. For a local
# one: docker run -d --name lb-postgres -e POSTGRES_USER=lb -e POSTGRES_PASSWORD=lb
#   -p 127.0.0.1:5432:5432 pgvector/pgvector:pg17
LB_DATABASE_URL=postgres://lb:lb@127.0.0.1:5432/lb
LB_REDIS_URL=redis://127.0.0.1:6379/0
# Optional, and for production: a database role per system, each granted its own schema and
# nothing else. Left unset, a system uses LB_DATABASE_URL.
# LB01_DATABASE_URL=
# LB02_DATABASE_URL=
# LB09_DATABASE_URL=

# The AI gateway (`just gateway`), for `just embed`. Make the key file with
# `just gateway-token keygen django-systems ~/.lb/django-systems.jwk.json` and paste the
# public key it prints into the gateway's LB_SERVICE_KEYS.
LB_GATEWAY_URL=http://127.0.0.1:8080
LB_SERVICE_NAME=django-systems
LB_SERVICE_KEY_FILE=

# The site's Ed25519 public key (base64url, a JWK's `x`), which visitor tokens must be
# signed with (core/visitors.py). Without it, the API refuses every visitor.
LB_WEB_TOKEN_KEY=

# LB-09 Meeting Recorder. Where recordings wait between the API and the worker (unset: a
# folder under the temporary directory), and where the private transcriber's faster-whisper
# weights are (unset: private mode reports it has no model; docs/DEPLOY.md, LB-09).
# LB09_AUDIO_DIR=
# LB09_WHISPER_DIR=
