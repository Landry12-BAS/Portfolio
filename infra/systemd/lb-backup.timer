# Starts lb-backup.service every night at 02:30 UTC. RandomizedDelaySec spreads the start
# by up to 15 minutes, and Persistent makes a run that was missed while the box was off
# happen at the next boot.
[Unit]
Description=Nightly database backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
