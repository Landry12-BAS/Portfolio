# Decrypts the live release's secrets into /run/lb/secrets, every time the box boots.
#
# /run is memory, so a reboot empties it. The containers keep working (Docker restarts them
# with the settings they were created with), but every `compose.sh` command needs the
# files, and so does the nightly backup. The deploy decrypts them itself before it starts a
# release; this unit does it once more at boot, for the release that was live.
#
# Install (docs/DEPLOY.md, The first deploy):
#   sudo install -m 0644 infra/systemd/lb-secrets.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable lb-secrets.service
[Unit]
Description=Decrypt the platform's secrets into memory
# Nothing to decrypt before the first deploy has made a release.
ConditionPathExists=/opt/lb/current/infra/scripts/decrypt-secrets.sh
# /run/lb is made by systemd-tmpfiles (lb.tmpfiles.conf) early in the boot.
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
Group=deploy
Environment=SOPS_AGE_KEY_FILE=/etc/lb/age.key
ExecStart=/opt/lb/current/infra/scripts/decrypt-secrets.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
