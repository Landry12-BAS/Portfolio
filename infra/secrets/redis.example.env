# The passwords of Redis's four users (infra/redis/users.acl.tmpl): the entrypoint hashes
# them into the ACL file when the container starts, so a change takes a restart of Redis.
# Each is made random by `just secrets-new redis`: 32 to 128 letters, digits, - or _.

# The gateway: its budget counters and run spans only.
LB_REDIS_PASSWORD_GATEWAY=@token

# The Django systems: their task queue, and run spans beside the gateway's.
LB_REDIS_PASSWORD_DJANGO_SYSTEMS=@token

# The health check, which may do nothing but PING.
LB_REDIS_PASSWORD_HEALTH=@token

# The owner's, for debugging over Tailscale: it may run any command.
LB_REDIS_PASSWORD_ADMIN=@token
