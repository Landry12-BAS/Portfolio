# Settings that name this deployment. Compose reads them for the ${...} in
# docker-compose.yml, and Caddy and the Django systems get them as environment. They are
# not secret, but they are kept with the secrets so that one release has one place to look.
#
# How a template reads (infra/secrets/README.md): a line NAME= is a variable the encrypted
# file must set to something, and `just secrets-check` fails while it is empty; a
# commented line, # NAME=, is optional; a value after the = is the default
# `just secrets-new` starts the file with; the value @token is a random token it makes.

# The API's public hostname: the name the Cloudflare Tunnel sends to Caddy, and the only
# Host the Django systems accept. A bare name such as api.example.com, no scheme.
LB_API_HOST=

# The site's origin as a browser sends it in the Origin header, scheme included, such as
# https://example.com. Caddy answers cross-origin calls from this one origin and no other.
LB_SITE_ORIGIN=

# The hosts the Django systems and the nightly backup may reach through their egress
# proxy, separated by commas: the R2 endpoint the backups go to (<account id>.r2.
# cloudflarestorage.com) and Sentry's ingest host (.ingest.sentry.io). Anything not
# listed is refused, so an empty list means nothing leaves.
LB_EGRESS_SYSTEMS_ALLOW=

# The registry namespace the images come from, when it is not ghcr.io/landry12-bas.
# LB_REGISTRY=
