# Settings that name this deployment. Compose reads them for the ${...} in
# docker-compose.yml, and Caddy and the three back ends (the Django, Flask and Node systems)
# get them as environment. They are not secret, but they are kept with the secrets so that
# one release has one place to look.
#
# How a template reads (infra/secrets/README.md): a line NAME= is a variable the encrypted
# file must set to something, and `just secrets-check` fails while it is empty; a
# commented line, # NAME=, is optional; a value after the = is the default
# `just secrets-new` starts the file with; the value @token is a random token it makes.

# The API's public hostname: the name the Cloudflare Tunnel sends to Caddy, and the only
# Host the Django and Flask systems accept. A bare name such as api.example.com, no scheme.
LB_API_HOST=

# The site's origin as a browser sends it in the Origin header, scheme included, such as
# https://example.com. Caddy answers cross-origin calls from this one origin and no other.
LB_SITE_ORIGIN=

# The site's public key, as the base64url `x` of the Ed25519 key pair the site signs its
# visitor tokens with (docs/DEPLOY.md, Provider keys and service keys). It is a public key,
# so it is not secret, and every back end verifies visitor tokens against this one value:
# kept here, it cannot drift between them. The private half goes to the site's host; without
# this key every visitor call is refused.
LB_WEB_TOKEN_KEY=

# The hosts the Django systems, the Flask systems (LB-03's files) and the nightly backup may
# reach through their egress proxy, separated by commas: the R2 endpoint the backups and
# the uploads go to (<account id>.r2.cloudflarestorage.com, the host of LB_R2_ENDPOINT
# below) and Sentry's ingest host (.ingest.sentry.io). Anything not listed is refused, so
# an empty list means nothing leaves.
LB_EGRESS_SYSTEMS_ALLOW=

# LB-03's uploads bucket on Cloudflare R2: its name, and R2's S3 endpoint, which is
# https://<account id>.r2.cloudflarestorage.com (your account ID is on the R2 overview
# page). The bucket is private, and the token that reaches it is in flask-systems.env
# (docs/DEPLOY.md, part 5). Neither is secret.
LB_LB03_BUCKET=lb-uploads
LB_R2_ENDPOINT=

# Make LB-03's OCR worker refuse every document when its kernel or container gives it no
# Landlock, one wall of the cage it reads a visitor's file in, instead of reading with one
# wall less. Leave it off until a document's trace on the box shows `landlock_abi` above 0
# (docs/DEPLOY.md, part 11), then set it to true.
# LB_LB03_REQUIRE_LANDLOCK=true

# The registry namespace the images come from, when it is not ghcr.io/landry12-bas.
# LB_REGISTRY=
