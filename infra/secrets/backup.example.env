# The nightly backup's settings, read by the backup job (infra/backup/backup.sh,
# docs/DEPLOY.md, Backups).

# The age PUBLIC keys each dump is encrypted to, separated by commas. Make the key pair on
# your own machine (`age-keygen -o lb-backup.key`; `age-keygen -y lb-backup.key` prints
# the public key), keep the private key OFF the box and out of this repository, and put
# only the public key here. A dump cannot be opened without that private key.
LB_BACKUP_AGE_RECIPIENTS=

# Where the encrypted dumps go: the remote named R2 below, then a bucket and a folder,
# written r2:<bucket>/<folder>.
LB_BACKUP_DESTINATION=

# The R2 remote, which rclone builds from these variables. The endpoint is
# https://<account id>.r2.cloudflarestorage.com, and its host must be in
# LB_EGRESS_SYSTEMS_ALLOW (compose.env). Make an R2 API token that can read and write
# objects in the backup bucket and nothing else, and put its key pair here.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# A token limited to one bucket cannot create buckets, so rclone must not try to.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
