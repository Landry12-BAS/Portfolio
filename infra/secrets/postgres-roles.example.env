# The passwords of the Postgres login roles, one per system. The postgres-provision job
# (infra/postgres/provision.sh) applies them on every deploy, and creates a role the first
# time it sees one, so rotating a password means editing this file and deploying. Each is
# made random by `just secrets-new postgres-roles`: 32 to 128 letters, digits, - or _.
#
# A new system adds one line, LB_PG_PASSWORD_<NAME IN CAPITALS>, for its name in
# infra/postgres/systems.txt. Until it is set, that role exists but cannot log in.

# The role LB-01's schema belongs to, and the login the Django systems use for LB-01.
LB_PG_PASSWORD_LB01=@token

# The role LB-02's schema belongs to, and the login the Django systems use for LB-02. It
# sees its own schema and the shared extensions schema (btree_gist), and nothing of LB-01's.
LB_PG_PASSWORD_LB02=@token

# The role LB-03's schema belongs to, and the login the Flask systems use for LB-03: it
# holds the documents of the hour, their readings and corrections, and the daily counters.
LB_PG_PASSWORD_LB03=@token

# The role LB-05's schema belongs to, and the login the Flask systems use for LB-05: it holds
# the daily question counters.
LB_PG_PASSWORD_LB05=@token

# The role LB-08's schema belongs to, and the login the Node systems use for LB-08.
LB_PG_PASSWORD_LB08=@token

# The role LB-04's schema belongs to, and the login the Node systems use for LB-04: its
# contracts, the text of their pages, their reports and the visitors' daily counters.
LB_PG_PASSWORD_LB04=@token
# The role LB-09's schema belongs to, and the login the Django systems use for LB-09: the
# meetings, their transcripts and items. It sees nothing of LB-01's or LB-02's.
LB_PG_PASSWORD_LB09=@token

# The role LB-06's schema belongs to, and the login the Node systems use for LB-06: its
# incidents, their event logs, the scenario cache and the visitors' daily counters.
LB_PG_PASSWORD_LB06=@token

# The role LB-07's schema belongs to, and the login the Node systems use for LB-07: its test
# runs, their steps, findings, evidence (screenshots) and reports with the generated tests, and
# the visitors' daily counters. The browser sandbox has no database login at all.
LB_PG_PASSWORD_LB07=@token

# The role the nightly backup logs in as. It reads every schema and can write nothing.
LB_PG_PASSWORD_LBBACKUP=@token

# The role that owns the platform schema (sessions, quotas, run spans). It stays unable
# to log in until the service that writes there exists and is given this password.
# LB_PG_PASSWORD_LBGATEWAY=
