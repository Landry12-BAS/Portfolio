# The Flask systems' secret settings (LB-03 and LB-05), read by flask-api only: the migration
# and the data job get no secret at all. Their database and Redis logins are built in
# docker-compose.yml from postgres-roles.env and redis.env, and the site's public key, the
# uploads bucket and its endpoint come from compose.env.

# This service's own key for calling the gateway: the private key file that `just
# gateway-token keygen flask-systems <file>` wrote, as one line of base64 (`base64 -w0
# <file>`, or `base64 -i <file> | tr -d '\n'` on macOS). The container's entrypoint writes
# it to a private file in memory. The matching public key is the flask-systems entry of
# the gateway's LB_SERVICE_KEYS.
LB_SERVICE_KEY_JWK_B64=

# LB-03 keeps the files visitors upload, and a picture of each page, in a private bucket on
# Cloudflare R2 for an hour (docs/DEPLOY.md, part 5). This is the API token made for that one
# bucket, with the permission Object Read and Write and nothing wider: the access key ID and
# the secret access key R2 shows once, when the token is made. The bucket's name and the
# endpoint are not secret and come from compose.env.
LB03_S3_ACCESS_KEY_ID=
LB03_S3_SECRET_ACCESS_KEY=
