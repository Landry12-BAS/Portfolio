# The Django systems' secret settings (LB-01 and LB-02), read by django-api, django-worker
# and django-migrate (services/django-systems/README.md). Their database and Redis logins
# are built in docker-compose.yml from postgres-roles.env and redis.env, and the site's
# public key comes from compose.env.

# Django's signing key (it must be at least 50 characters). `just secrets-new
# django-systems` makes a random one.
DJANGO_SECRET_KEY=@token:32

# This service's own key for calling the gateway: the private key file that `just
# gateway-token keygen django-systems <file>` wrote, as one line of base64 (`base64 -w0
# <file>`, or `base64 -i <file> | tr -d '\n'` on macOS). The container's entrypoint writes
# it to a private file in memory. The matching public key is the django-systems entry of
# the gateway's LB_SERVICE_KEYS.
LB_SERVICE_KEY_JWK_B64=
