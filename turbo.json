{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["svg/**", "scripts/**"],
      "outputs": ["sprite.svg", "src/generated/**"]
    },
    "check": {},
    "lint": {},
    "test": {
      "passThroughEnv": ["LB_TEST_REDIS_URL", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "typecheck": {}
  }
}
