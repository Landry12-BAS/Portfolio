          "segments": [
            {
              "position": 0,
              "start": 0.3,
              "end": 4.325,
              "text": "Good morning everyone, this is Hannah. Let's plan Monday's roast.",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 1,
              "start": 4.725,
              "end": 10.95,
              "text": "Peter here. The Colombian green beans arrived on Friday, so we can start with those.",
              "speaker": 1,
              "label": "Peter"
            },
            {
              "position": 2,
              "start": 11.35,
              "end": 14.94,
              "text": "Good. Then we roast the Colombian first on Monday.",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 3,
              "start": 15.34,
              "end": 19.7,
              "text": "I'm David, I run packaging. We are short of twelve ounce bags.",
              "speaker": 2,
              "label": "David"
            },
            {
              "position": 4,
              "start": 20.1,
              "end": 23.79,
              "text": "I will order two thousand more twelve ounce bags by Wednesday.",
              "speaker": 1,
              "label": "Peter"
            },
            {
              "position": 5,
              "start": 24.19,
              "end": 28.33,
              "text": "Kevin, can you re-profile the Colombian on the small roaster?",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 6,
              "start": 28.73,
              "end": 31.205,
              "text": "Sure, I'll do it on Sunday evening.",
              "speaker": 3,
              "label": "Speaker 1"
            },
            {
              "position": 7,
              "start": 31.605,
              "end": 34.56,
              "text": "And the Ethiopian moves to Tuesday, agreed?",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 8,
              "start": 34.96,
              "end": 38.56,
              "text": "Agreed. I'll update the label template by Friday.",
              "speaker": 2,
              "label": "David"
            },
            {
              "position": 9,
              "start": 38.96,
              "end": 40.785,
              "text": "Great, thanks everyone.",
              "speaker": 0,
              "label": "Hannah"
            }
          ]
        }
      }
