# The settings of the site's server (docs/DEPLOY.md, part 10). Copy this to apps/web/.env, which git
# ignores, and fill it in. Leave all of them empty and the site runs with its demos off, as a Vercel
# preview does: the catalog and the datasheets work, and a demo says it has no back end.
#
# Everything but the Turnstile site key stays on the server and never reaches the browser. The site
# refuses to start if some are set and any is wrong (the message names the variable, never its value).

# The origin of the Django, Flask and Node systems' API, and of the gateway's one public route
# (GET /v1/runs/<id>/spans). https:// for a real host; plain http:// only for localhost.
NUXT_LB_API_URL=
NUXT_LB_GATEWAY_URL=

# The site's private key, which signs visitor tokens: the contents of the `site` key file that
# `just gateway-token keygen site <file>` writes, on one line. Its public half is LB_WEB_TOKEN_KEY
# in the back ends' settings.
NUXT_LB_WEB_SIGNING_KEY=

# The `web` service's private key, for the gateway's trace route: the contents of the `web` key file
# (`just gateway-token keygen web <file>`). Its public half is an entry of the gateway's LB_SERVICE_KEYS.
NUXT_LB_GATEWAY_SERVICE_KEY=

# The secret the anonymous sessions are made from: `just secret-token 32`.
NUXT_LB_SESSION_SECRET=

# Cloudflare Turnstile. For local development Cloudflare publishes keys that always pass:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# The site's one address, such as https://example.com. Any other host that reaches the site (www., the
# *.vercel.app addresses) is sent on to it with a 308, so a visitor has one session and one quota, not one for
# each address. Leave it empty and the site answers on any host, as a preview does and as it does locally.
NUXT_LB_SITE_ORIGIN=

# To try the demos without a back end or any of these, run `just dev-mock`: it starts the mock back end
# and the dev server with throwaway keys.
