                  "passage:shipping.late-parcels",
                  "order:BB-1041"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "We will update you on the investigation within 2 working days.",
                "citations": [
                  "passage:shipping.late-parcels"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Thank you for your patience.",
                "citations": [],
