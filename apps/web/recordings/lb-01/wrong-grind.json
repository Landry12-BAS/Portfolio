              {
                "text": "Please confirm that the delivery address on that order is still correct so we can send the replacement.",
                "citations": [],
                "supported": false,
                "problem": "states a fact without citing a source"
              },
              {
                "text": "Thank you for your understanding.",
                "citations": [],
