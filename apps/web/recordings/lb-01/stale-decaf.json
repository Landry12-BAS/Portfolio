          "draft": {
            "sentences": [
              {
                "text": "Dobrý den, paní Nováková,",
                "citations": [],
                "supported": true,
                "problem": null
              },
              {
                "text": "děkujeme za vaši zprávu ohledně objednávky BB-1046.",
                "citations": [
                  "order:BB-1046"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Podle našich záznamů byla káva v této objednávce opražená 30. 8. 2026 a objednávka byla doručena 4. 10. 2026.",
                "citations": [
                  "order:BB-1046"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Protože káva dorazila více než 30 dnů po datu pražení, máte nárok na výměnu zboží nebo vrácení peněz.",
                "citations": [
                  "passage:damaged.stale-coffee",
                  "order:BB-1046"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Prosím, dejte nám vědět, kterou z těchto možností si přejete.",
                "citations": [
                  "passage:damaged.stale-coffee"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Vrácení zboží hradíme my a pošleme vám e-mailem předplacený štítek, takže pro vás bude vrácení zdarma.",
                "citations": [
                  "passage:returns.prepaid-labels"
                ],
                "supported": true,
                "problem": null
              },
              {
                "text": "Tým podpory Basalt & Bean",
                "citations": [],
                "supported": true,
                "problem": null
              }
            ],
            "claims_supported": true,
            "model": "qwen/qwen3.8-27b",
            "sources": [
              {
                "id": "order:BB-1046",
                "title": "Order BB-1046",
                "text": "Order BB-1046: delivered. Dates: placed 2026-10-01, roasted 2026-08-30, shipped 2026-10-02, delivered 2026-10-04. Ships to CZ with Vltava Post, tracking number VP481950061CZ. Items: 2 x Lava Decaf, moka, 250 g, at 299 CZK each. Delivery 89 CZK. Total 687 CZK."
              },
              {
                "id": "passage:damaged.stale-coffee",
                "title": "Poškozené, staré nebo chybné zboží §2: Stará káva",
                "text": "Na každém sáčku je datum pražení. Pokud k vám sáček dorazí více než 30 dnů po datu pražení, dejte nám vědět do 14 dnů od doručení a my ho vyměníme, nebo vám vrátíme peníze, podle toho, co si vyberete."
              },
              {
                "id": "passage:returns.prepaid-labels",
                "title": "Vrácení zboží a peněz §5: Předplacené štítky pro vrácení",
                "text": "U poškozeného, starého nebo chybného zboží hradíme vrácení my: pošleme vám e-mailem předplacený štítek a vrácení vás nic nestojí."
              }
            ]
          },
