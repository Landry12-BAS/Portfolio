          "segments": [
            {
              "position": 0,
              "start": 0,
              "end": 4.14,
              "text": "Good morning everyone, this is Hannah. Let's plan Monday's roast.",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 1,
              "start": 4.9,
              "end": 10.72,
              "text": "Peter here. The Colombian green beans arrived on Friday, so we can start with those.",
              "speaker": 1,
              "label": "Peter"
            },
            {
              "position": 2,
              "start": 11.52,
              "end": 14.62,
              "text": "Good. Then we roast the Colombian first on Monday.",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 3,
              "start": 15.56,
              "end": 19.42,
              "text": "I'm David. I run packaging. We are short of 12-ounce bags.",
              "speaker": 2,
              "label": "David"
            },
            {
              "position": 4,
              "start": 20.08,
              "end": 23.48,
              "text": "I will order 2,000 more 12-ounce bags by Wednesday.",
              "speaker": 2,
              "label": "David"
            },
            {
              "position": 5,
              "start": 24.42,
              "end": 27.96,
              "text": "Kevin, can you rate-profile the Colombian on the small roaster?",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 6,
              "start": 28.78,
              "end": 31.04,
              "text": "Sure, I'll do it on Sunday evening.",
              "speaker": 3,
              "label": "Speaker 1"
            },
            {
              "position": 7,
              "start": 31.76,
              "end": 34.2,
              "text": "And the Ethiopian moves to Tuesday, agreed?",
              "speaker": 0,
              "label": "Hannah"
            },
            {
              "position": 8,
              "start": 35.02,
              "end": 38.36,
              "text": "Agreed. I'll update the label template by Friday.",
              "speaker": 1,
              "label": "Peter"
            },
            {
              "position": 9,
              "start": 39.12,
              "end": 40.4,
              "text": "Great, thanks everyone.",
              "speaker": 0,
              "label": "Hannah"
            }
          ]
        }
      }
