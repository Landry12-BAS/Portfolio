              "sql": "SELECT p.product_id, p.name, SUM(ol.line_total_czk) AS revenue FROM order_lines ol JOIN orders o ON ol.order_id = o.order_id JOIN products p ON ol.product_id = p.product_id WHERE o.ordered_at BETWEEN DATE '2025-01-01' AND DATE '2025-12-31' AND o.status NOT IN ('cancelled', 'lost') GROUP BY p.product_id, p.name ORDER BY revenue DESC LIMIT 5",
