            "sql": "SELECT\n  p.product_id AS product_id,\n  p.name AS name,\n  SUM(ol.line_total_czk) AS revenue\nFROM order_lines AS ol\nJOIN orders AS o\n  ON ol.order_id = o.order_id\nJOIN products AS p\n  ON ol.product_id = p.product_id\nWHERE\n  o.ordered_at BETWEEN CAST('2025-01-01' AS DATE) AND CAST('2025-12-31' AS DATE)\n  AND NOT o.status IN ('cancelled', 'lost')\nGROUP BY\n  p.product_id,\n  p.name\nORDER BY\n  revenue DESC\nLIMIT 5",
