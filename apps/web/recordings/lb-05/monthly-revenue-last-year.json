            "sql": "SELECT\n  DATE_TRUNC('MONTH', orders.ordered_at) AS month,\n  SUM(order_lines.line_total_czk) AS revenue\nFROM orders AS orders\nJOIN order_lines AS order_lines\n  ON order_lines.order_id = orders.order_id\nWHERE\n  orders.ordered_at BETWEEN CAST('2025-01-01' AS DATE) AND CAST('2025-12-31' AS DATE)\n  AND NOT orders.status IN ('cancelled', 'lost')\nGROUP BY\n  DATE_TRUNC('MONTH', orders.ordered_at)\nORDER BY\n  month\nLIMIT 1000",
