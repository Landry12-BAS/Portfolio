          "attempts": [
            {
              "message": null,
              "rule": null,
              "sql": "WITH purchases AS (\n  SELECT o.customer_id, p.name AS product, o.ordered_at AS day\n  FROM orders o\n  JOIN order_lines ol ON ol.order_id = o.order_id\n  JOIN products p ON p.product_id = ol.product_id\n  WHERE o.status NOT IN ('cancelled', 'lost')\n    AND p.kind = 'coffee'\n),\nearlier AS (\n  SELECT DISTINCT customer_id, product\n  FROM purchases\n  WHERE day BETWEEN DATE '2026-04-01' AND DATE '2026-06-30'\n),\nbefore_earlier AS (\n  SELECT DISTINCT customer_id, product\n  FROM purchases\n  WHERE day < DATE '2026-04-01'\n),\nasked AS (\n  SELECT DISTINCT customer_id, product\n  FROM purchases\n  WHERE day BETWEEN DATE '2026-07-01' AND DATE '2026-09-30'\n)\nSELECT earlier.product AS product,\n       COUNT(*) AS lost_repeat_buyers\nFROM earlier\nJOIN before_earlier\n  ON before_earlier.customer_id = earlier.customer_id\n AND before_earlier.product = earlier.product\nLEFT JOIN asked\n  ON asked.customer_id = earlier.customer_id\n AND asked.product = earlier.product\nWHERE asked.customer_id IS NULL\nGROUP BY earlier.product\nORDER BY lost_repeat_buyers DESC",
              "stopped_by": null
            }
