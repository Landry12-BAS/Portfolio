            "sql": "WITH purchases AS (\n  SELECT\n    o.customer_id AS customer_id,\n    p.name AS product,\n    o.ordered_at AS day\n  FROM orders AS o\n  JOIN order_lines AS ol\n    ON ol.order_id = o.order_id\n  JOIN products AS p\n    ON p.product_id = ol.product_id\n  WHERE\n    NOT o.status IN ('cancelled', 'lost') AND p.kind = 'coffee'\n), earlier AS (\n  SELECT DISTINCT\n    purchases.customer_id AS customer_id,\n    purchases.product AS product\n  FROM purchases AS purchases\n  WHERE\n    purchases.day BETWEEN CAST('2026-04-01' AS DATE) AND CAST('2026-06-30' AS DATE)\n), before_earlier AS (\n  SELECT DISTINCT\n    purchases.customer_id AS customer_id,\n    purchases.product AS product\n  FROM purchases AS purchases\n  WHERE\n    purchases.day < CAST('2026-04-01' AS DATE)\n), asked AS (\n  SELECT DISTINCT\n    purchases.customer_id AS customer_id,\n    purchases.product AS product\n  FROM purchases AS purchases\n  WHERE\n    purchases.day BETWEEN CAST('2026-07-01' AS DATE) AND CAST('2026-09-30' AS DATE)\n)\nSELECT\n  earlier.product AS product,\n  COUNT(*) AS lost_repeat_buyers\nFROM earlier AS earlier\nJOIN before_earlier AS before_earlier\n  ON before_earlier.customer_id = earlier.customer_id\n  AND before_earlier.product = earlier.product\nLEFT JOIN asked AS asked\n  ON asked.customer_id = earlier.customer_id AND asked.product = earlier.product\nWHERE\n  asked.customer_id IS NULL\nGROUP BY\n  earlier.product\nORDER BY\n  lost_repeat_buyers DESC\nLIMIT 1000",
            "tables": [
              "order_lines",
              "orders",
              "products"
            ],
