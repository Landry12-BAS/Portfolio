            "sql": "SELECT\n  products.name AS product,\n  SUM(order_lines.line_total_czk) AS revenue\nFROM order_lines AS order_lines\nJOIN orders AS orders\n  ON order_lines.order_id = orders.order_id\nJOIN products AS products\n  ON order_lines.product_id = products.product_id\nWHERE\n  NOT orders.status IN ('cancelled', 'lost')\n  AND orders.ordered_at BETWEEN CAST('2026-07-01' AS DATE) AND CAST('2026-09-30' AS DATE)\nGROUP BY\n  products.name\nORDER BY\n  revenue DESC\nLIMIT 1000",
